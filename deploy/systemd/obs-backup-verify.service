[Unit]
Description=Verify latest SQLite backup integrity
After=local-fs.target
ConditionPathIsMountPoint=/mnt/backup

[Service]
Type=oneshot
User=observatory
Group=observatory
EnvironmentFile=/etc/observatory/observatory.env
ExecStart=/usr/bin/bash /opt/observatory/scripts/verify-latest-backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=obs-backup-verify
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# --- Sandbox (security audit 2026-10-20, F45). Tested by
# tests/test_systemd_hardening.py; check live with `systemd-analyze security`.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Backups hold the whole sensor history: owner+group only (audit F11).
UMask=0027
PrivateDevices=yes
ReadWritePaths=/var/lib/observatory /mnt/backup
