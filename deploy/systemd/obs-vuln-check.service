[Unit]
Description=Observatory daily Dependabot vulnerability check (-> Telegram)
Documentation=https://docs.github.com/en/rest/dependabot/alerts
After=network-online.target chrony.service time-sync.target
Wants=network-online.target

[Service]
Type=oneshot
User=observatory
Group=observatory
EnvironmentFile=/etc/observatory/observatory.env
# Telegram bot token: root-only (0600) file loaded only by the three units
# that send Telegram messages (audit F46). Loaded after observatory.env, so it wins.
EnvironmentFile=-/etc/observatory/telegram.env
# The GitHub token lives in its own root-only (0600) file that no other unit
# loads (audit F46). Loaded last, so it wins over observatory.env.
EnvironmentFile=-/etc/observatory/vuln-check.env
ExecStart=/opt/observatory/.venv/bin/python -m observatory.ops.vuln_check
StandardOutput=journal
StandardError=journal
SyslogIdentifier=obs-vuln-check
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# --- Sandbox (security audit 2026-10-20, F45). Tested by
# tests/test_systemd_hardening.py; check live with `systemd-analyze security`.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
PrivateDevices=yes
ReadWritePaths=/var/lib/observatory
# ProtectHome hides /home, but uv (~/.cache, ~/.local/share) and pip-audit
# (~/.pip-audit-cache) look there: HOME moves to the writable cache dir.
CacheDirectory=obs-vuln-check
Environment=HOME=/var/cache/obs-vuln-check UV_PYTHON_PREFERENCE=only-system
