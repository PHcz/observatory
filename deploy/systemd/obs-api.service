[Unit]
Description=Observatory FastAPI (health endpoint + Phase 6 extensions)
Documentation=file:///opt/observatory/CLAUDE.md
After=network-online.target chrony.service time-sync.target
Wants=network-online.target

[Service]
Type=notify
User=observatory
Group=observatory
EnvironmentFile=/etc/observatory/observatory.env
WorkingDirectory=/opt/observatory
ExecStart=/opt/observatory/.venv/bin/python -m observatory.api
Restart=on-failure
RestartSec=5s
WatchdogSec=30s
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=obs-api
Nice=0
IOSchedulingClass=best-effort
IOSchedulingPriority=4

# Binds [::]:8000 dual-stack (API_BIND_HOST, default "::"); nftables admits
# :8000 from the LAN only (deploy/nftables/observatory.nft).

# --- Sandbox (security audit 2026-10-20, F45). Tested by
# tests/test_systemd_hardening.py; check live with `systemd-analyze security`.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
# vcgencmd (Pi temperature for /api/health) talks to the VideoCore mailbox.
SupplementaryGroups=video
DevicePolicy=closed
DeviceAllow=/dev/vcio rw
ReadWritePaths=/var/lib/observatory

[Install]
WantedBy=multi-user.target
