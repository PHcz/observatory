[Unit]
Description=Observatory Blitzortung lightning WebSocket ingest (long-running)
Documentation=https://www.blitzortung.org/
After=network-online.target chrony.service time-sync.target
Wants=network-online.target chrony.service

[Service]
# Type=notify long-running service (NOT a timer). Blitzortung's data shape
# is a continuous stream, not a periodic snapshot. WatchdogSec=60s gives
# headroom for the 30s reconnect backoff plus a one-flush-cycle margin;
# the client pings WATCHDOG=1 every ~20s gated on frame-or-flush activity.
Type=notify
User=observatory
Group=observatory
EnvironmentFile=/etc/observatory/observatory.env
WorkingDirectory=/opt/observatory
ExecStart=/opt/observatory/.venv/bin/python -m observatory.pollers.blitzortung
Restart=on-failure
RestartSec=10s
WatchdogSec=60s
TimeoutStopSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=obs-blitzortung
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# --- Sandbox (security audit 2026-10-20, F45). Tested by
# tests/test_systemd_hardening.py; check live with `systemd-analyze security`.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
PrivateDevices=yes
ReadWritePaths=/var/lib/observatory

[Install]
WantedBy=multi-user.target
