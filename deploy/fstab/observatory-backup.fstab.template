# observatory-backup
# To activate: format the stick ext4 with label OBS_BACKUP (docs/OPERATIONS.md),
# then uncomment this line in /etc/fstab. Mounted by label so a stick swap needs
# no edit; nosuid,nodev,noexec because nothing on a removable backup stick should
# ever be executable or a device node (audit F52).
LABEL=OBS_BACKUP /mnt/backup ext4 defaults,nofail,nosuid,nodev,noexec 0 2
